PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow?schema=public"
JWT_SECRET="taskflow_super_secret_jwt_key_2026"
JWT_REFRESH_SECRET="taskflow_super_secret_refresh_key_2026"
FRONTEND_URL="http://localhost:3000"

# Redis / Valkey Cache & Session Configuration
# REDIS_URL="rediss://default:password@host:port" # Optional: Recommended for Cloud Redis / Aiven / Upstash
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379


# SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_email@example.com"
SMTP_PASS="your_app_password"
FROM_EMAIL="TaskFlow App <no-reply@taskflow.com>"

# AI Agent Engine Configuration
# AI_PROVIDER Options: "gemini" | "openai" | "groq" | "mistral" | "minimax" | "ollama" | "custom"
AI_PROVIDER="minimax"
AI_API_KEY="your_api_key_here"
AI_MODEL="MiniMax-M2.7"
AI_BASE_URL=""

